{
  "expo": {
    "name": "LIFTIQ",
    "slug": "liftiq",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.liftiq.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.liftiq.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "liftiq-local"
      }
    }
  }
}
