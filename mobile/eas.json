{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "hosted": {
      "env": {
        "APP_ENV": "staging"
      }
    },
    "preview": {
      "extends": "hosted",
      "environment": "preview",
      "distribution": "internal"
    },
    "production": {
      "extends": "hosted",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
