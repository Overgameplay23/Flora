# Luna app environment: PUBLIC values only. Everything in this file ends up inside the app bundle.
#
# Profiles (APP_ENV picks one; app.config.js reads it and hands the values to the app):
#   local    .env.local    written for you by `npm run backend:env` (the local Docker stack). Don't hand-edit.
#   staging  .env.staging  copy this file to .env.staging and fill it in for the hosted staging project.
#
# Run the app with `npm run start:local` or `npm run start:staging`. Both clear Metro's cache, which otherwise
# can keep the previous profile inside a web bundle. On CI/EAS set APP_ENV and these variables in the build
# environment instead of a file.
#
# .env.local and .env.staging are gitignored; only this example is committed.
# NEVER put here: a service-role or secret key, the database password, or any provider key (OpenAI, Gemini...).
# Those are server secrets: see supabase/functions/.env.example. app.config.js refuses service-role and secret keys.

# Project URL, from the project's API settings in the Supabase dashboard. Staging must be https://<project-ref>.supabase.co;
# the local profile must be a local address (http://127.0.0.1:56321 or this machine's LAN IP).
EXPO_PUBLIC_SUPABASE_URL=

# The project's publishable key (sb_publishable_...) or its legacy anon key, from the dashboard's API keys
# settings. Public by design: row-level security protects the data, not this key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Base URL for Edge Functions when it is not <project URL>/functions/v1. Only the optional painted
# portrait (pet-stylize) reads it. Leave empty.
EXPO_PUBLIC_SUPABASE_FUNCTIONS_URL=

# Optional and unused for requests; only shown on the network debug screen. Leave empty.
EXPO_PUBLIC_API_URL=

# Local design work only: 1 shows the pet-talk screen with stand-in replies before the OpenAI key exists.
# Refused for the staging profile. Leave empty.
EXPO_PUBLIC_PET_TALK_PREVIEW=

# Feature flag for the pet conversation (pet-talk, OpenAI). Off unless set to 1. With it off the app never calls
# the function, even when the function is deployed and has its key. Leave empty until the owner turns it on.
EXPO_PUBLIC_PET_TALK_ENABLED=
