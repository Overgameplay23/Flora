{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:phone": "node scripts/start-expo-phone.js",
    "start:tunnel": "node scripts/start-expo-phone.js --tunnel",
    "start:local": "node scripts/expo-profile.js local start",
    "start:staging": "node scripts/expo-profile.js staging start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:functions": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/pet-stylize/index.ts supabase/functions/pet-chat/index.ts supabase/functions/weekly-summary/index.ts supabase/functions/pet-talk/index.ts",
    "test": "jest",
    "export:web": "node scripts/check-export-web.js",
    "check": "npm run typecheck && npm run typecheck:functions && npm test && npm run export:web",
    "backend:build": "node local-backend/build-migrations.js",
    "backend:start": "node local-backend/build-migrations.js && supabase start --workdir local-backend",
    "backend:reset": "node local-backend/build-migrations.js && supabase db reset --workdir local-backend",
    "backend:stop": "supabase stop --workdir local-backend",
    "backend:status": "supabase status --workdir local-backend",
    "backend:test": "supabase test db --workdir local-backend",
    "backend:env": "node local-backend/write-env-local.js",
    "backend:seed": "node local-backend/seed-demo.js",
    "backend:link": "supabase link --workdir local-backend",
    "backend:push": "supabase db push --workdir local-backend",
    "backend:dump": "node scripts/backend-dump.js",
    "functions:deploy": "supabase functions deploy --workdir local-backend",
    "functions:secrets": "supabase secrets set --workdir local-backend",
    "supabase:deploy:pet": "supabase functions deploy pet-stylize --project-ref gghesvpmskjlrlpoosgf",
    "supabase:logs:pet": "supabase functions logs pet-stylize --project-ref gghesvpmskjlrlpoosgf --tail",
    "supabase:deploy:pet-chat": "supabase functions deploy pet-chat --project-ref gghesvpmskjlrlpoosgf",
    "supabase:logs:pet-chat": "supabase functions logs pet-chat --project-ref gghesvpmskjlrlpoosgf --tail",
    "supabase:deploy:weekly-summary": "supabase functions deploy weekly-summary --project-ref gghesvpmskjlrlpoosgf",
    "supabase:logs:weekly-summary": "supabase functions logs weekly-summary --project-ref gghesvpmskjlrlpoosgf --tail"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@supabase/supabase-js": "^2.50.3",
    "axios": "^1.10.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "jpeg-js": "^0.4.4",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native-community/cli": "latest",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
