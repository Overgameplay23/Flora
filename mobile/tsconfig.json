{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "noEmit": true,
    // TypeScript 6 (SDK 56+) turned `strict` on and stopped loading every @types package by default.
    // The code was written against the old defaults, so they are stated here explicitly.
    "strict": false,
    "types": ["jest", "node"]
  },
  "include": [
    "App.js",
    "index.js",
    "app/**/*",
    "src/**/*",
    "nativewind-env.d.ts",
    "C:\\Users\\donov\\floura\\mobile\\nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "liftiq",
    "supabase",
    "android",
    "ios",
    "dist",
    ".expo",
    ".expo-export-check",
    "scripts",
    "server",
    "dataconnect",
    "tmp",
    "docs"
  ]
}
